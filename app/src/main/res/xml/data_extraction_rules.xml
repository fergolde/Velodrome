<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never back up encrypted credential storage. -->
        <exclude domain="sharedpref" path="velodrome_encrypted_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Never transfer encrypted credential storage. -->
        <exclude domain="sharedpref" path="velodrome_encrypted_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
